# ========================================================
# OpenCRM Backend Environment Configuration
# ========================================================

# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=crm_user
DB_PASSWORD=crm_password
DB_NAME=opencrm
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis Cache & Session
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=supersecret_jwt_key_crm_development_replace_in_prod_12345
JWT_REFRESH_SECRET=supersecret_refresh_jwt_key_crm_development_replace_in_prod_54321
JWT_EXPIRES_IN=900s
JWT_REFRESH_EXPIRES_IN=7d

# Currency Configuration
DEFAULT_CURRENCY=BRL

# Application URL (for email links)
APP_URL=http://localhost

# Mailgun Email Delivery
# Optional in development: if omitted, emails are safely logged to console (simulation fallback)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=OpenCRM <no-reply@opencrm.com>
MAILGUN_HOST=api.mailgun.net
